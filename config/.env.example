# Copie este arquivo para .env no NUC e/ou no servidor GPU.
# Não coloque segredos reais em Git.

# -----------------------------------------------------------------------------
# NUC: Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME

# Opcional. Se vazio, aceita qualquer chat que fale com o bot.
# Use IDs separados por vírgula para restringir acesso.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# -----------------------------------------------------------------------------
# NUC: caminhos locais
# -----------------------------------------------------------------------------
DATA_DIR=data
AUDIO_DIR=audio/inbox
SQLITE_PATH=data/voice_memo.sqlite3

# -----------------------------------------------------------------------------
# NUC: backend GPU local
# -----------------------------------------------------------------------------
GPU_SERVER_URL=http://GPU_SERVER_IP:8088
GPU_HEALTH_TIMEOUT_SECONDS=2
GPU_PROCESS_TIMEOUT_SECONDS=360
POLL_INTERVAL_SECONDS=2
MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=60

# -----------------------------------------------------------------------------
# NUC: fallback cloud
# -----------------------------------------------------------------------------
# OpenAI fica só para transcrição de áudio.
OPENAI_API_KEY=sk-REPLACE_ME
CLOUD_STT_MODEL=gpt-4o-mini-transcribe
CLOUD_TIMEOUT_SECONDS=180

# DeepSeek faz a estruturação da nota a partir da transcrição.
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# Só é usado se DEEPSEEK_API_KEY estiver vazio.
CLOUD_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# NUC: Notion
# -----------------------------------------------------------------------------
NOTION_TOKEN=secret_REPLACE_ME
NOTION_DATA_SOURCE_ID=REPLACE_ME
NOTION_API_VERSION=2026-03-11

# Alias aceito se você já usava esse nome no VoiceMemo antigo:
# NOTION_DATASOURCE_ID=REPLACE_ME

# Compatibilidade com API antiga do Notion. Prefira NOTION_DATA_SOURCE_ID.
NOTION_DATABASE_ID=

# Ajuste estes nomes para baterem exatamente com as propriedades do seu database.
# Se a propriedade ficar vazia, o conteúdo é salvo no corpo da página.
NOTION_TITLE_PROPERTY=Name
NOTION_CLEAN_NOTE_PROPERTY=
NOTION_SUMMARY_PROPERTY=
NOTION_TRANSCRIPT_PROPERTY=
NOTION_TASKS_PROPERTY=
NOTION_TAGS_PROPERTY=Tags
NOTION_SOURCE_PROPERTY=
NOTION_PROCESSOR_PROPERTY=

# Opcionais, úteis se essas opções já existem no database.
NOTION_STATUS_PROPERTY=
NOTION_STATUS_VALUE=
NOTION_SYSTEM_STATUS_PROPERTY=Status do sistema
NOTION_SYSTEM_STATUS_VALUE=Processed
NOTION_CREATED_PROPERTY=Created

# -----------------------------------------------------------------------------
# GPU: FastAPI
# -----------------------------------------------------------------------------
GPU_HOST=0.0.0.0
GPU_PORT=8088

# -----------------------------------------------------------------------------
# GPU: faster-whisper + Ollama/Qwen
# -----------------------------------------------------------------------------
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
TRANSCRIPTION_LANGUAGE=pt
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=700

# Opcional: use quando as libs CUDA/cuDNN já existem em outro venv ou instalação.
# EXTRA_LD_LIBRARY_PATH=/caminho/para/nvidia/cublas/lib:/caminho/para/nvidia/cudnn/lib
