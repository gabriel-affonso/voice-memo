[Unit]
Description=VoiceMemo NUC Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/voice-memo
EnvironmentFile=/opt/voice-memo/.env
ExecStart=/opt/voice-memo/.venv/bin/python -m voice_memo.orchestrator
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

